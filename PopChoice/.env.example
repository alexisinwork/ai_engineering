# Copy to .env and fill in. .env is gitignored.
#
# PopChoice shares the Supabase project with ../EmbeddingsAndVectorDB — it only
# adds a table and a match function, so the same URL and keys work for both.

# --- Browser-exposed (VITE_ prefix) ---------------------------------------
# Vite inlines these into the JS bundle. Anyone loading the page can read them.

# Supabase URL + publishable key. Public by design — safe to ship.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OpenAI key. NOT safe to ship — this one really does end up readable in
# devtools. Fine for local practice, never for a deployed page. See README.
# Also read by ingest.js and eval.js, which run in Node.
VITE_OPENAI_API_KEY=sk-...

# --- Secret (no VITE_ prefix, Node only) ----------------------------------
# service_role bypasses RLS entirely. Never prefix this with VITE_ and never
# import it from browser code. Dashboard > Project Settings > API keys.
SUPABASE_SERVICE_ROLE_KEY=
